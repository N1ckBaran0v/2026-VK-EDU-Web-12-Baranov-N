# Django
DJANGO_SECRET_KEY=YOUR_SECRET_KEY_HERE
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL
POSTGRES_DB=application_db
POSTGRES_USER=application_user
POSTGRES_PASSWORD=super_secret_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Совпадает с POSTGRES_* — для сервиса web
DATABASE_URL=postgres://application_user:super_secret_password_change_me@db:5432/application_db